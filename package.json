{
  "name": "calculo-decaimientos",
  "version": "53.0.0",
  "private": true,
  "type": "module",
  "description": "PWA local para calcular el decaimiento de fuentes radiactivas y materiales contaminados.",
  "scripts": {
    "test": "npm run test:syntax && npm run test:release && npm run test:unit && npm run test:data && npm run test:e2e",
    "release": "node scripts/release.mjs",
    "test:release": "node scripts/release.mjs --check",
    "test:syntax": "node scripts/check-syntax.mjs",
    "test:unit": "node --test tests/domain.test.mjs tests/resilience.test.mjs tests/service-worker.test.mjs",
    "test:data": "node --test tests/data.test.mjs",
    "test:e2e": "node scripts/test-browser.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1"
  }
}
